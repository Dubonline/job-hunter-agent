+/// `on-demand` defers Runtime event delivery until a diagnostic consumer asks
+/// for it. Runtime.evaluate remains available without subscribing to events.
+pub(crate) fn parse_runtime_events_setting(value: Option<&str>) -> Result<bool, String> {
+    match value {
+        None | Some("eager") => Ok(true),
+        Some("on-demand") => Ok(false),
+        Some(other) => Err(format!(
+            "Invalid AGENT_BROWSER_RUNTIME_EVENTS '{}': expected eager or on-demand",
+            other
+        )),
+    }
+}
+
+pub(crate) fn runtime_events_from_env() -> Result<bool, String> {
+    parse_runtime_events_setting(
+        std::env::var("AGENT_BROWSER_RUNTIME_EVENTS")
+            .ok()
+            .as_deref(),
+    )
+}
